<IfModule mod_rewrite.c>
    Options -Indexes

    RewriteEngine On

    # Redirect all requests to /public (Laravel entry point)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
